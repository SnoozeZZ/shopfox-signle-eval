# Copy to .env and fill in your values:
#   cp .env.example .env

# Docker / deploy.sh host port (container listens on 5090)
HOST_PORT=5090

# Alibaba Cloud Bailian (DashScope) — used by KR3-9 SPU model accuracy LLM
DASHSCOPE_API_KEY=

# Price crawler — used by KR3-11 offer price accuracy
CRAWLER_URL=http://47.251.122.154:8762/api/ai/crawl/price
CRAWLER_REQUEST_TIMEOUT=60
CRAWLER_BATCH_SIZE=31
CRAWLER_MAX_IN_FLIGHT=32
CRAWLER_SUBMIT_INTERVAL=1.0
CRAWLER_MAX_RETRIES=3
CRAWLER_RETRY_BACKOFF_SEC=2.0

# Category expand crawler — used by KR4-5 top3 link completeness
CRAWLER_API=http://47.77.190.33:8763/api/category/expand
CRAWLER_TIMEOUT=600

# Backend callback after report eval job completes (POST JSON with reportId/runId)
EVAL_CALLBACK_URL=
EVAL_CALLBACK_ENABLED=false
EVAL_CALLBACK_TIMEOUT_SEC=30
